# App environment
NODE_ENV=dev
PORT=12001

# Detrás de un proxy inverso (Render = 1). Sin esto el rate limit ve una sola IP.
#TRUST_PROXY=1

# Token de POST /api/comercios/force-scrape (sin definir, la ruta está deshabilitada). Genera uno: openssl rand -hex 32
#FORCE_SCRAPE_TOKEN=

# Frecuencia del scrapeo: expresión cron de 5 campos (minuto hora día-del-mes mes día-de-la-semana).
# Por defecto cada 5 min. Mínimo permitido: 5 min entre ejecuciones (más seguido se ignora y avisa).
# Ejemplos: */15 * * * * (cada 15 min) · 0 * * * * (cada hora) · 0 8-22 * * * (cada hora de 8 a 22)
#SCRAPE_CRON=*/5 * * * *
# Zona horaria de la expresión (IANA). Por defecto, la del servidor (UTC en Docker/Render)
#SCRAPE_CRON_TIMEZONE=Europe/Madrid

# User-Agent con el que el scraper se identifica ante la web oficial. Por defecto:
# ComercioCastellonNotificator/<versión> (+https://bono-castellon.alvaromaxter.es/; ...). Solo ASCII, máx. 300.
# Conviene incluir una forma de contacto (web o email) por si la web oficial necesita avisarte.
#SCRAPER_USER_AGENT=

# Salud (/api/health): minutos máximos sin actualizar los datos.
# Si no se define, se deduce de SCRAPE_CRON (1,5 × el mayor hueco entre ejecuciones, mínimo 15)
#HEALTH_MAX_AGE_MINUTES=15

# Zona válida para las coordenadas de los comercios (por defecto Castelló, 30 km)
#GEO_CENTER_LAT=39.986359
#GEO_CENTER_LNG=-0.037652
#GEO_RADIUS_KM=30

# Caché HTTP de los GET de /api/comercios/* (segundos; 0 = el cliente revalida siempre). Por defecto 60
#CACHE_MAX_AGE_SECONDS=60

# Máximo de entradas del histórico de altas/bajas en Redis (las más antiguas se descartan). Por defecto 500
#HISTORY_MAX_ENTRIES=500

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_NAMESPACE=bonos
REDIS_PASSWORD=1234
# Alternativa (Upstash, etc.): sustituye host/port/password
#REDIS_URL=rediss://default:PASSWORD@HOST:6379
# Base de datos de Redis. Con REDIS_URL se usa la 0 (o la de la URL); sin URL: prod 0, staging 1, resto 2
#REDIS_DB=0

# Mail config
# MAIL_PROVIDER: smtp (por defecto) o resend (API HTTPS; necesario en hosts que bloquean SMTP, p. ej. Render gratis)
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tumailer@gmail.com
MAIL_PASS=1234 1234 1234 1234
MAIL_TO=to@gmail.com # varios: a@x.com,b@y.com
MAIL_SECURE=false
MAIL_ENABLED=true

# Solo con MAIL_PROVIDER=resend
#RESEND_API_KEY=re_xxxxxxxxxxxx
#MAIL_FROM=Bonos Castelló <avisos@tudominio.es>   # dominio verificado en Resend

# App URLs
#FRONTEND_URL=http://localhost:4200
