# App environment
NODE_ENV=dev
PORT=12001

# Detrás de un proxy inverso (Render = 1). Sin esto el rate limit ve una sola IP.
#TRUST_PROXY=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_NAMESPACE=bonos
REDIS_PASSWORD=1234
# Alternativa (Upstash, etc.): sustituye host/port/password
#REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Mail config
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tumailer@gmail.com
MAIL_PASS=1234 1234 1234 1234
MAIL_TO=to@gmail.com
MAIL_SECURE=false
MAIL_ENABLED=true

# App URLs
#FRONTEND_URL=http://localhost:4200
