# App environment
NODE_ENV=dev
PORT=12001

# Detrás de un proxy inverso (Render = 1). Sin esto el rate limit ve una sola IP.
#TRUST_PROXY=1

# Token de POST /api/comercios/force-scrape (sin definir, la ruta está deshabilitada). Genera uno: openssl rand -hex 32
#FORCE_SCRAPE_TOKEN=

# Salud (/api/health): minutos máximos sin actualizar los datos
#HEALTH_MAX_AGE_MINUTES=15

# Zona válida para las coordenadas de los comercios (por defecto Castelló, 30 km)
#GEO_CENTER_LAT=39.986359
#GEO_CENTER_LNG=-0.037652
#GEO_RADIUS_KM=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_NAMESPACE=bonos
REDIS_PASSWORD=1234
# Alternativa (Upstash, etc.): sustituye host/port/password
#REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Mail config
# MAIL_PROVIDER: smtp (por defecto) o resend (API HTTPS; necesario en hosts que bloquean SMTP, p. ej. Render gratis)
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tumailer@gmail.com
MAIL_PASS=1234 1234 1234 1234
MAIL_TO=to@gmail.com # varios: a@x.com,b@y.com
MAIL_SECURE=false
MAIL_ENABLED=true

# Solo con MAIL_PROVIDER=resend
#RESEND_API_KEY=re_xxxxxxxxxxxx
#MAIL_FROM=Bonos Castelló <avisos@tudominio.es>   # dominio verificado en Resend

# App URLs
#FRONTEND_URL=http://localhost:4200
